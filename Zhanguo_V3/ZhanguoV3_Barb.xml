<?xml version="1.0" encoding="utf-8"?>
<GameInfo>
	<GlobalParameters>
		<!-- no camp is seeded on turn 1 (default 33% of the target number appears in the first turn) -->
		<Update><Where Name="BARBARIAN_CAMP_FIRST_TURN_PERCENT_OF_TARGET_TO_ADD"/><Set Value="0"/></Update>
		<!-- camps must be at least 8 tiles from any city (default 4) -->
		<Update><Where Name="BARBARIAN_CAMP_MINIMUM_DISTANCE_CITY"/><Set Value="8"/></Update>
		<!-- fewer camps per major civ (default 3) -->
		<Update><Where Name="BARBARIAN_CAMP_MAX_PER_MAJOR_CIV"/><Set Value="2"/></Update>
		<!-- slower build-up to large raids (default 2) -->
		<Update><Where Name="BARBARIAN_BOLDNESS_PER_TURN"/><Set Value="1"/></Update>
		<!-- barbarian units are a bit less advanced (default 50) -->
		<Update><Where Name="BARBARIAN_TECH_PERCENT"/><Set Value="40"/></Update>
	</GlobalParameters>
</GameInfo>
