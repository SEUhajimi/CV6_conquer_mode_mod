      </Properties>
      <File>Data/Icons.sql</File>
    </UpdateIcons>
    <UpdateArt id="HanArtFront">
      <File>Han_LiuBei.dep</File>
    </UpdateArt>
  </FrontEndActions>
  <InGameActions>
    <UpdateDatabase id="HanGameplay">
      <Properties>
        <LoadOrder>1000</LoadOrder>
      </Properties>
      <Criteria>GS</Criteria>
      <File>Data/Gameplay.sql</File>
      <File>Data/Promotions.sql</File>
    </UpdateDatabase>
    <UpdateText id="HanTextGame">
      <Properties>
        <LoadOrder>1000</LoadOrder>
      </Properties>
      <Criteria>GS</Criteria>
      <File>Data/Text.xml</File>
    </UpdateText>
    <UpdateColors id="HanColors">
      <Properties>
        <LoadOrder>1000</LoadOrder>
      </Properties>
      <Criteria>GS</Criteria>
      <File>Data/Colors.xml</File>
    </UpdateColors>
    <UpdateIcons id="HanIconsGame">
      <Properties>
        <LoadOrder>1000</LoadOrder>
      </Properties>
      <Criteria>GS</Criteria>
      <File>Data/Icons.sql</File>
    </UpdateIcons>
    <AddGameplayScripts id="HanTigers">
      <Criteria>GS</Criteria>
      <File>Scripts/HanTigers.lua</File>
