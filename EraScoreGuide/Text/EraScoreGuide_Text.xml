			<Text>How to earn Era Score</Text>
		</Replace>
		<Replace Tag="LOC_ESG_SUMMARY_GOLDEN" Language="en_US">
			<Text>You have reached the Golden Age threshold. Keep going for a Heroic Age if you are in a Dark Age.</Text>
		</Replace>
